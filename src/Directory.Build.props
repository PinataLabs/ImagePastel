<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Must be set before the root props, which use it for the output paths. -->
  <PropertyGroup>
    <SixLaborsProjectCategory>src</SixLaborsProjectCategory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Common NuGet package settings. -->
  <PropertyGroup>
    <Copyright>Copyright © Six Labors and contributors. Copyright © Pinata Labs.</Copyright>
    <Authors>Pinata Labs</Authors>
    <Company>Pinata Labs</Company>
    <VersionPrefix>0.0.1</VersionPrefix>
    <VersionPrefix Condition="'$(packageversion)' != ''">$(PackageVersion)</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- CI only: deterministic build, symbol package and MinVer versioning. -->
  <PropertyGroup Condition="'$(IsContinuousIntegration)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerVerbosity>normal</MinVerVerbosity>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsContinuousIntegration)' == 'true'">
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- DynamicProxyGenAssembly2 is needed so Moq can use our internals -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="ImagePastel.Benchmarks" Key="$(PinataLabsPublicKey)" />
    <InternalsVisibleTo Include="ImagePastel.Tests.ProfilingSandbox" Key="$(PinataLabsPublicKey)" />
    <InternalsVisibleTo Include="PinataLabs.ImagePastel.Tests" Key="$(PinataLabsPublicKey)" />
  </ItemGroup>

</Project>
