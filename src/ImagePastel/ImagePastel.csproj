<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PinataLabs.ImagePastel</AssemblyName>
    <AssemblyTitle>PinataLabs.ImagePastel</AssemblyTitle>
    <RootNamespace>PinataLabs.ImagePastel</RootNamespace>
    <PackageId>PinataLabs.ImagePastel</PackageId>
    <PackageIcon>pinatalabs.imagepastel.128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/PinataLabs/ImagePastel/</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageTags>ImagePastel Image Resize Crop Gif Jpg Jpeg Jxl JpegXL Bitmap Pbm Png Tga Tiff WebP NetCore</PackageTags>
    <Description>A fully managed, cross-platform 2D graphics library for .NET. A community fork of PinataLabs.ImagePastel 2.1.x under the Apache License 2.0. Not affiliated with Six Labors.</Description>
    <Configurations>Debug;Release;Debug-InnerLoop;Release-InnerLoop</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versions continue the Apache-2.0 2.1.x line. -->
    <MinVerMinimumMajorMinor>2.2</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <Choose>
    <When Condition="$(Configuration.EndsWith('InnerLoop')) == true">
      <PropertyGroup>
        <TargetFrameworks>$(ImageSharpNetTargetFrameworks)</TargetFrameworks>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TargetFrameworks>$(ImageSharpNetTargetFrameworks);netstandard2.1</TargetFrameworks>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <None Include="..\..\build\branding\pinatalabs.imagepastel.128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Code that used to come from T4 templates is written by gen/ImagePastel.SourceGenerators.
    The generated files are under artifacts/obj/src/ImagePastel/<configuration>/<tfm>/generated/.
  -->
  <PropertyGroup>
    <ImageSharpGeneratedSources>Library</ImageSharpGeneratedSources>
  </PropertyGroup>

  <Import Project="..\..\gen\ImagePastel.SourceGenerators.props" />

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
