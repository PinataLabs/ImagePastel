<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Must be set before the root props, which use it for the output paths. -->
  <PropertyGroup>
    <SixLaborsProjectCategory>tests</SixLaborsProjectCategory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <IsTestProject Condition="'$(IsTestProject)' == ''">true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!--
      SA0001: XML comment analysis is disabled due to project configuration.
      Test projects do not generate documentation files. StyleCop reports SA0001 without a
      source location, so a path-scoped .editorconfig section cannot reliably suppress it.
    -->
    <NoWarn>$(NoWarn);SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="coverlet.collector" PrivateAssets="All" Condition="'$(IsCodeCoverage)' == 'true'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\ImagePastel\ImagePastel.csproj" />
  </ItemGroup>

</Project>
