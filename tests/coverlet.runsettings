<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
    <RunConfiguration>
        <!--Used in conjunction with ActiveIssueAttribute to skip tests with known issues-->
        <TestCaseFilter>category!=failing</TestCaseFilter>
    </RunConfiguration>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat code coverage">
                <Configuration>
                    <!-- opencover is the format SonarQube reads for C#. -->
                    <Format>lcov,cobertura,opencover</Format>
                    <!--
                      The library, from ImageSharp.Tests, and the source generator, from
                      ImageSharp.SourceGenerators.Tests. Each test project loads only one of them.
                    -->
                    <Include>[PinataLabs.ImagePastel]*,[ImageSharp.SourceGenerators]*</Include>
                    <!-- Output of gen/ImageSharp.SourceGenerators, written under obj/.../generated/. -->
                    <ExcludeByFile>**/generated/ImageSharp.SourceGenerators/**/*.cs</ExcludeByFile>
                    <!--
                      Record only whether each line and branch ran, not how often. Counting every hit
                      makes test classes that run the same code in parallel contend for the same
                      counters, which slowed the coverage run several times over. Line and branch
                      coverage, and SonarQube, only need to know whether code ran.
                    -->
                    <SingleHit>true</SingleHit>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
