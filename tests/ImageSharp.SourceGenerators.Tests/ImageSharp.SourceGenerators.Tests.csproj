<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SixLabors.ImageSharp.SourceGenerators.Tests</AssemblyName>
    <RootNamespace>SixLabors.ImageSharp.SourceGenerators.Tests</RootNamespace>
    <!-- xUnit.net v3 test projects are stand-alone executables. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Debug-InnerLoop;Release-InnerLoop</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/Directory.Build.props references the library. These tests only need the generator. -->
    <ProjectReference Remove="$(MSBuildThisFileDirectory)..\..\src\ImageSharp\ImageSharp.csproj" />
    <ProjectReference Include="..\..\gen\ImageSharp.SourceGenerators\ImageSharp.SourceGenerators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The expected generator output. It is test data, not code of this project. -->
    <Compile Remove="Expected\**" />
    <None Include="Expected\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The snapshot refresh writes to the source tree, not to the build output. -->
    <AssemblyMetadata Include="ExpectedDirectory" Value="$(MSBuildProjectDirectory)$([System.IO.Path]::DirectorySeparatorChar)Expected" />
  </ItemGroup>

</Project>
