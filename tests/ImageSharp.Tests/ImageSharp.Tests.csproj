<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DebugSymbols>True</DebugSymbols>
    <AssemblyName>SixLabors.ImageSharp.Tests</AssemblyName>
    <!-- xUnit.net v3 test projects are stand-alone executables. -->
    <OutputType>Exe</OutputType>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <RootNamespace>SixLabors.ImageSharp.Tests</RootNamespace>
    <Configurations>Debug;Release;Debug-InnerLoop;Release-InnerLoop</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageSharp.Tests.ProfilingSandbox" Key="$(PinataLabsPublicKey)" />
  </ItemGroup>

  <!--
    The specialized pixel operation tests are written by gen/ImageSharp.SourceGenerators.
    The generated files are under artifacts/obj/tests/ImageSharp.Tests/<configuration>/<tfm>/generated/.
  -->
  <PropertyGroup>
    <ImageSharpGeneratedSources>Tests</ImageSharpGeneratedSources>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- ci-apicompat.ps1 renames the library with a global AssemblyName; the generator keeps its own. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ImageSharpGeneratedSources" />
    <ProjectReference Include="..\..\gen\ImageSharp.SourceGenerators\ImageSharp.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="AssemblyName" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
    <PackageReference Include="Microsoft.DotNet.RemoteExecutor" />
    <PackageReference Include="Moq" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestFonts\OpenSans-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestFonts\SixLaborsSampleAB.woff">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

