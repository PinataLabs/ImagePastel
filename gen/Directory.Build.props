<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Build-time tools such as the source generator. They are not shipped, so this file does not
    import src/Directory.Build.props: no package metadata, MinVer, documentation file or
    InternalsVisibleTo list.
  -->

  <!-- Must be set before the root props, which use it for the output paths. -->
  <PropertyGroup>
    <SixLaborsProjectCategory>gen</SixLaborsProjectCategory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      SA0001: XML comment analysis is disabled due to project configuration.
      These projects do not generate documentation files. StyleCop reports SA0001 without a
      source location, so a path-scoped .editorconfig section cannot reliably suppress it.
    -->
    <NoWarn>$(NoWarn);SA0001</NoWarn>
  </PropertyGroup>

</Project>
