<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Settings shared by every project. src/ and tests/ have their own Directory.Build.props,
    which set SixLaborsProjectCategory and then import this file.
  -->

  <PropertyGroup>
    <!-- For some reason Debug-InnerLoop doesn't define DEBUG by default. -->
    <DefineConstants Condition="'$(Configuration)' == 'Debug-InnerLoop'">$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <!-- Environment switches, passed as -p:CI=true and -p:codecov=true (CI sets CI=true itself). -->
  <PropertyGroup>
    <IsContinuousIntegration Condition="'$(CI)' == 'true'">true</IsContinuousIntegration>
    <IsCodeCoverage Condition="'$(codecov)' == 'true'">true</IsCodeCoverage>
    <DefineConstants Condition="'$(IsContinuousIntegration)' == 'true'">$(DefineConstants);ENV_CI</DefineConstants>
    <DefineConstants Condition="'$(IsCodeCoverage)' == 'true'">$(DefineConstants);ENV_CODECOV</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
    <DefineConstants Condition="'$(IsWindows)' == 'true'">$(DefineConstants);OS_WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Compilation settings that differ from the SDK defaults. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>strict;IOperation</Features>
    <NeutralLanguage>en</NeutralLanguage>
    <OverwriteReadOnlyFiles>true</OverwriteReadOnlyFiles>
    <Nullable>disable</Nullable>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- Pin the analyzer rule set so SDK updates do not introduce new warnings unannounced. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Ensure all custom build configurations based upon "Release" are optimized. -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Release')) == true">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Build output goes to artifacts/{obj,bin,pkg}/<category>/<project>/. -->
  <PropertyGroup>
    <BaseArtifactsPath>$(MSBuildThisFileDirectory)artifacts/</BaseArtifactsPath>
    <BaseArtifactsPathSuffix>$(SixLaborsProjectCategory)/$(MSBuildProjectName)</BaseArtifactsPathSuffix>
    <BaseIntermediateOutputPath>$(BaseArtifactsPath)obj/$(BaseArtifactsPathSuffix)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BaseArtifactsPath)bin/$(BaseArtifactsPathSuffix)/</BaseOutputPath>
    <PackageOutputPath>$(BaseArtifactsPath)pkg/$(BaseArtifactsPathSuffix)/$(Configuration)/</PackageOutputPath>
  </PropertyGroup>

  <!-- Strong-name signing. PinataLabsPublicKey is the public half, for InternalsVisibleTo. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build\PinataLabs.snk</AssemblyOriginatorKeyFile>
    <PinataLabsPublicKey></PinataLabsPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build\stylecop.json" />
  </ItemGroup>

</Project>
